[Unit]
Description=ograph-gen - Open Graph image generator
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ograph-gen
ExecStart=/opt/ograph-gen/ograph-gen
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target